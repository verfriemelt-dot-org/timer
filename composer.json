{
    "name": "verfriemelt/timer",
    "type": "project",
    "require": {
        "php": "~8.5",
        "verfriemelt/wrapped": "@dev"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1.54",
        "phpstan/phpstan-strict-rules": "^2.0.11",
        "phpstan/phpstan-phpunit": "^2.0.16",
        "phpunit/phpunit": "^12.5.24",
        "tomasvotruba/type-coverage": "^2.1.0",
        "friendsofphp/php-cs-fixer": "^3.95.1",
        "rector/rector": "^2.4.2",
        "phpstan/phpstan-deprecation-rules": "^2.0.4",
        "infection/infection": "^0.32.7",
        "phpat/phpat": "^0.12.4",
        "phpbench/phpbench": "^1.6.1"
    },
    "autoload": {
        "psr-4": {
            "timer\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "timer\\tests\\": "tests"
        }
    },
    "config": {
        "preferred-install": {
            "verfriemelt/wrapped": "source"
        },
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
